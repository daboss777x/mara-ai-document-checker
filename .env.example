# Mara: every environment variable in the system, grouped by where it lives.
# Copy to .env (git-ignored) for local work. Never commit real values.
# Generate MARA_HMAC_SECRET with: bash scripts/gen-hmac-secret.sh
# The same MARA_HMAC_SECRET must be set in all three places (Vercel, Modal, Supabase Vault).

# ---------------------------------------------------------------------------
# Vercel (web/). NEXT_PUBLIC_* are shipped to the browser: never put secrets there.
# ---------------------------------------------------------------------------
# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key; RLS applies to every query made with it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public base URL of the web app (magic-link redirects), e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=
# Base URL of the Mara Modal app, used by the web to call Mara. Server-only.
MARA_URL=
# Shared secret for X-Mara-Signature on web -> Mara requests. Server-only.
MARA_HMAC_SECRET=
# Demo mode: 1 = the web serves typed fixtures and skips login (no Supabase needed).
MARA_DEMO=
# Demo mode is refused when NODE_ENV=production unless this is 1 (hosted demo only).
MARA_DEMO_ALLOW_PROD=
# Open login (hosted demo on real Supabase): any details sign in as this one demo agent. Server-only.
MARA_OPEN_LOGIN=
DEMO_AGENT_EMAIL=
DEMO_AGENT_PASSWORD=

# ---------------------------------------------------------------------------
# Modal secret "mara-secrets" (mara/). Service-role access lives ONLY here.
# ---------------------------------------------------------------------------
# Same value as MARA_HMAC_SECRET above; verifies the signature on every endpoint.
# MARA_HMAC_SECRET=   (listed above; set it in Modal too)
# staging | prod
MARA_ENV=
# Anthropic API key for all model calls.
ANTHROPIC_API_KEY=
# Model used for the document check.
MARA_CHECK_MODEL=claude-opus-5-5
# Supabase project URL (same project as the web app's).
SUPABASE_URL=
# Supabase service-role key; bypasses RLS, so Mara checks permissions in code.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string Mara uses via psycopg 3 (service role).
DATABASE_URL=
# egosms | off. off = demo: nothing is texted (messages recorded as blocked "sms_disabled").
MARA_SMS_MODE=egosms
# 0 = demo: client links open without the SMS code.
MARA_CLIENT_VERIFY=1
# EgoSMS credentials (the only SMS provider).
EGOSMS_USERNAME=
EGOSMS_PASSWORD=
# Sender ID shown to recipients.
EGOSMS_SENDER_ID=
# EgoSMS API endpoint (kept configurable; confirm against their current docs).
EGOSMS_API_URL=https://www.egosms.co/api/v1/json/
# Web app base URL, for client portal links in SMS: {PUBLIC_SITE_URL}/c/{token}
PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Supabase Vault (set with vault.create_secret in SQL, not env vars).
# Read by mara.notify_event(); if missing (local tests) the trigger does nothing.
# ---------------------------------------------------------------------------
# mara_events_url   = {MARA_URL}/events
# mara_hmac_secret  = same value as MARA_HMAC_SECRET
