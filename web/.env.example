# /web environment variables (Vercel + local). Never put the Supabase service-role key here.

# Supabase (anon key only; RLS applies to every query from the web app)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public base URL of this app, used for magic-link redirects (e.g. http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Mara on Modal (server-only; the web's base URL for Mara, used by lib/mara-client.ts)
MARA_URL=
MARA_HMAC_SECRET=

# Demo mode: 1 = typed fixtures, no login, no Supabase. Refused in production
# unless MARA_DEMO_ALLOW_PROD=1 (hosted demo only).
MARA_DEMO=
MARA_DEMO_ALLOW_PROD=

# Open login (hosted demo on real Supabase): any details sign in as this one demo agent.
MARA_OPEN_LOGIN=
DEMO_AGENT_EMAIL=
DEMO_AGENT_PASSWORD=
